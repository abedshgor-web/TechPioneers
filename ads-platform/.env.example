# منفذ الخادم
PORT=4000

# سر توقيع JWT — استبدله بقيمة عشوائية قوية في الإنتاج
JWT_SECRET=change-me-in-production

# مسار قاعدة بيانات SQLite (للإنتاج انتقل إلى PostgreSQL — راجع docs/ads-platform/06)
DB_PATH=./data/ads.db

# حساب المدير الأولي — يُنشأ تلقائياً عند الإقلاع إن لم يكن موجوداً
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong

# Stripe — اتركها فارغة في التطوير واستخدم ALLOW_DEV_TOPUP=1 بدلاً منها
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
APP_URL=http://localhost:4000

# يسمح بشحن تجريبي مباشر بدون Stripe (للتطوير فقط) — لا تفعّله في الإنتاج
ALLOW_DEV_TOPUP=0

# مكافحة الاحتيال: نافذة التقييد الترددي (دقائق) وأقصى نقرات مدفوعة لكل مستخدم/إعلان
FRAUD_WINDOW_MIN=60
FRAUD_MAX_CLICKS=1
