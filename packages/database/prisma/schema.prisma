generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [pgcrypto, pg_trgm, unaccent]
}

// ─────────────────────────────────────────────────────────
// TENANTS — top-level container for all customer data
// ─────────────────────────────────────────────────────────

model Tenant {
  id                   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                 String         @unique @db.VarChar(63)
  name                 String         @db.VarChar(255)
  plan                 PlanTier       @default(starter)
  status               TenantStatus   @default(trial)
  trialEndsAt          DateTime?      @map("trial_ends_at")
  stripeCustomerId     String?        @unique @map("stripe_customer_id")
  stripeSubscriptionId String?        @unique @map("stripe_subscription_id")
  stripePriceId        String?        @map("stripe_price_id")
  billingInterval      BillingInterval? @map("billing_interval")
  seatsPurchased       Int            @default(3) @map("seats_purchased")
  currentPeriodEnd     DateTime?      @map("current_period_end")
  cancelAtPeriodEnd    Boolean        @default(false) @map("cancel_at_period_end")
  settings             Json           @default("{}") @db.JsonB
  dataRegion           String         @default("us") @map("data_region") @db.VarChar(10)
  customDomain         String?        @unique @map("custom_domain") @db.VarChar(255)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  memberships          TenantMembership[]
  contacts             Contact[]
  companies            Company[]
  deals                Deal[]
  pipelines            Pipeline[]
  tasks                Task[]
  notes                Note[]
  activities           Activity[]
  emailLogs            EmailLog[]
  customFieldDefs      CustomFieldDefinition[]
  savedViews           SavedView[]
  apiKeys              ApiKey[]
  webhookEndpoints     WebhookEndpoint[]
  stripeEvents         StripeEvent[]
  auditLogs            AuditLog[]

  @@map("tenants")
}

// ─────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at")
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  firstName       String?   @map("first_name") @db.VarChar(100)
  lastName        String?   @map("last_name") @db.VarChar(100)
  avatarUrl       String?   @map("avatar_url") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships     TenantMembership[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordReset[]
  emailVerifications EmailVerification[]

  @@map("users")
}

model TenantMembership {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  role       UserRole  @default(member)
  invitedBy  String?   @map("invited_by") @db.Uuid
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("tenant_memberships")
}

// ─────────────────────────────────────────────────────────
// AUTH TOKENS
// ─────────────────────────────────────────────────────────

model RefreshToken {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash") @db.VarChar(255)
  familyId   String   @map("family_id") @db.Uuid
  userAgent  String?  @map("user_agent") @db.VarChar(500)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordReset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

// ─────────────────────────────────────────────────────────
// CRM ENTITIES
// ─────────────────────────────────────────────────────────

model Contact {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  ownerId        String?   @map("owner_id") @db.Uuid
  createdById    String?   @map("created_by") @db.Uuid
  firstName      String?   @map("first_name") @db.VarChar(100)
  lastName       String?   @map("last_name") @db.VarChar(100)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(50)
  jobTitle       String?   @map("job_title") @db.VarChar(150)
  companyId      String?   @map("company_id") @db.Uuid
  status         ContactStatus @default(active)
  source         String?   @db.VarChar(100)
  tags           String[]  @default([])
  customFields   Json      @default("{}") @map("custom_fields") @db.JsonB
  lastActivityAt DateTime? @map("last_activity_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company?  @relation(fields: [companyId], references: [id])
  deals          Deal[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  emailLogs      EmailLog[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, ownerId])
  @@index([tenantId, companyId])
  @@index([tenantId, lastActivityAt(sort: Desc)])
  @@index([tenantId, deletedAt])
  @@map("contacts")
}

model Company {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  createdById  String?  @map("created_by") @db.Uuid
  name         String   @db.VarChar(255)
  domain       String?  @db.VarChar(255)
  industry     String?  @db.VarChar(100)
  size         String?  @db.VarChar(50)
  website      String?  @db.VarChar(500)
  phone        String?  @db.VarChar(50)
  address      Json?    @db.JsonB
  tags         String[] @default([])
  customFields Json     @default("{}") @map("custom_fields") @db.JsonB
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts     Contact[]
  deals        Deal[]

  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, domain])
  @@map("companies")
}

// ─────────────────────────────────────────────────────────
// PIPELINE & DEALS
// ─────────────────────────────────────────────────────────

model Pipeline {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String   @db.VarChar(255)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages     PipelineStage[]
  deals      Deal[]

  @@index([tenantId])
  @@map("pipelines")
}

model PipelineStage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pipelineId  String   @map("pipeline_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String   @db.VarChar(100)
  position    String   @db.VarChar(50)
  probability Int      @default(0)
  color       String?  @db.VarChar(7)
  isWon       Boolean  @default(false) @map("is_won")
  isLost      Boolean  @default(false) @map("is_lost")
  createdAt   DateTime @default(now()) @map("created_at")

  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@index([pipelineId])
  @@index([tenantId])
  @@map("pipeline_stages")
}

model Deal {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String     @map("tenant_id") @db.Uuid
  pipelineId       String     @map("pipeline_id") @db.Uuid
  stageId          String     @map("stage_id") @db.Uuid
  ownerId          String?    @map("owner_id") @db.Uuid
  contactId        String?    @map("contact_id") @db.Uuid
  companyId        String?    @map("company_id") @db.Uuid
  createdById      String?    @map("created_by") @db.Uuid
  name             String     @db.VarChar(255)
  value            Decimal?   @db.Decimal(15, 2)
  currency         String     @default("USD") @db.VarChar(3)
  probability      Int?
  expectedCloseDate DateTime? @map("expected_close_date") @db.Date
  actualCloseDate  DateTime?  @map("actual_close_date") @db.Date
  status           DealStatus @default(open)
  lostReason       String?    @map("lost_reason") @db.VarChar(255)
  customFields     Json       @default("{}") @map("custom_fields") @db.JsonB
  deletedAt        DateTime?  @map("deleted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline         Pipeline      @relation(fields: [pipelineId], references: [id])
  stage            PipelineStage @relation(fields: [stageId], references: [id])
  contact          Contact?      @relation(fields: [contactId], references: [id])
  company          Company?      @relation(fields: [companyId], references: [id])
  tasks            Task[]
  notes            Note[]
  activities       Activity[]

  @@index([tenantId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, stageId])
  @@index([tenantId, ownerId])
  @@index([tenantId, status])
  @@index([tenantId, expectedCloseDate])
  @@map("deals")
}

// ─────────────────────────────────────────────────────────
// TASKS, NOTES, ACTIVITIES
// ─────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  createdById String?    @map("created_by") @db.Uuid
  assignedTo  String?    @map("assigned_to") @db.Uuid
  entityType  String?    @map("entity_type") @db.VarChar(50)
  entityId    String?    @map("entity_id") @db.Uuid
  contactId   String?    @map("contact_id") @db.Uuid
  dealId      String?    @map("deal_id") @db.Uuid
  title       String     @db.VarChar(500)
  description String?    @db.Text
  type        TaskType   @default(task)
  status      TaskStatus @default(open)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?  @map("due_date")
  reminderAt  DateTime?  @map("reminder_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact?   @relation(fields: [contactId], references: [id])
  deal        Deal?      @relation(fields: [dealId], references: [id])

  @@index([tenantId])
  @@index([tenantId, assignedTo])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@map("tasks")
}

model Note {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  createdById String?  @map("created_by") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  contactId   String?  @map("contact_id") @db.Uuid
  dealId      String?  @map("deal_id") @db.Uuid
  content     Json     @db.JsonB
  contentText String?  @map("content_text") @db.Text
  isPinned    Boolean  @default(false) @map("is_pinned")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact     Contact? @relation(fields: [contactId], references: [id])
  deal        Deal?    @relation(fields: [dealId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@map("notes")
}

model Activity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  type       String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  contactId  String?  @map("contact_id") @db.Uuid
  dealId     String?  @map("deal_id") @db.Uuid
  metadata   Json     @default("{}") @db.JsonB
  occurredAt DateTime @default(now()) @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact    Contact? @relation(fields: [contactId], references: [id])
  deal       Deal?    @relation(fields: [dealId], references: [id])

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@map("activities")
}

model EmailLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  loggedById   String?  @map("logged_by") @db.Uuid
  contactId    String?  @map("contact_id") @db.Uuid
  dealId       String?  @map("deal_id") @db.Uuid
  direction    String   @db.VarChar(10)
  fromAddress  String?  @map("from_address") @db.VarChar(255)
  toAddresses  String[] @map("to_addresses")
  subject      String?  @db.VarChar(500)
  bodyText     String?  @map("body_text") @db.Text
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [contactId], references: [id])

  @@index([tenantId])
  @@index([tenantId, contactId])
  @@map("email_logs")
}

// ─────────────────────────────────────────────────────────
// CUSTOM FIELDS
// ─────────────────────────────────────────────────────────

model CustomFieldDefinition {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(50)
  fieldKey     String   @map("field_key") @db.VarChar(100)
  label        String   @db.VarChar(150)
  fieldType    String   @map("field_type") @db.VarChar(50)
  options      Json?    @db.JsonB
  isRequired   Boolean  @default(false) @map("is_required")
  isSearchable Boolean  @default(false) @map("is_searchable")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entityType, fieldKey])
  @@index([tenantId, entityType])
  @@map("custom_field_definitions")
}

// ─────────────────────────────────────────────────────────
// VIEWS & API
// ─────────────────────────────────────────────────────────

model SavedView {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  createdById  String?  @map("created_by") @db.Uuid
  entityType   String   @map("entity_type") @db.VarChar(50)
  name         String   @db.VarChar(100)
  filters      Json     @db.JsonB
  columns      Json?    @db.JsonB
  sortBy       String?  @map("sort_by") @db.VarChar(100)
  sortDir      String   @default("asc") @map("sort_dir") @db.VarChar(4)
  isShared     Boolean  @default(false) @map("is_shared")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType])
  @@map("saved_views")
}

model ApiKey {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  createdById String?   @map("created_by") @db.Uuid
  name        String    @db.VarChar(100)
  keyHash     String    @unique @map("key_hash") @db.VarChar(255)
  keyPrefix   String    @map("key_prefix") @db.VarChar(12)
  scopes      String[]  @default([])
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model WebhookEndpoint {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  url       String    @db.VarChar(500)
  events    String[]
  secret    String    @db.VarChar(255)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  endpointId     String    @map("endpoint_id") @db.Uuid
  eventType      String    @map("event_type") @db.VarChar(100)
  payload        Json      @db.JsonB
  status         String    @db.VarChar(20)
  responseStatus Int?      @map("response_status")
  attemptCount   Int       @default(0) @map("attempt_count")
  nextAttemptAt  DateTime? @map("next_attempt_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

// ─────────────────────────────────────────────────────────
// BILLING
// ─────────────────────────────────────────────────────────

model StripeEvent {
  id          String   @id @db.VarChar(255)
  tenantId    String?  @map("tenant_id") @db.Uuid
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at")

  tenant      Tenant?  @relation(fields: [tenantId], references: [id])

  @@map("stripe_events")
}

// ─────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  before      Json?    @db.JsonB
  after       Json?    @db.JsonB
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  occurredAt  DateTime @default(now()) @map("occurred_at")

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum TenantStatus {
  trial
  active
  past_due
  canceled
  paused
}

enum PlanTier {
  starter
  professional
  enterprise
}

enum BillingInterval {
  monthly
  annual
}

enum UserRole {
  owner
  admin
  member
  viewer
}

enum ContactStatus {
  active
  archived
}

enum DealStatus {
  open
  won
  lost
}

enum TaskType {
  task
  call
  meeting
  email
}

enum TaskStatus {
  open
  completed
  canceled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}
